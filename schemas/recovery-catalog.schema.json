{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-content-workbench/recovery-catalog.schema.json",
  "title": "AI 内容工作台部署恢复规则库",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "platforms", "versions", "match_any", "category",
          "action", "safe_to_retry", "customer_message"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["macos", "windows"]}
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "match_any": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "category": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "safe_to_retry": {"type": "boolean"},
          "customer_message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
